<?xml version="1.0"?>
<ruleset name="HashtagMedia Toolkit">
	<description>WordPress Coding Standards voor HashtagMedia Toolkit.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="hashtagmedia-toolkit"/>
			</property>
		</properties>
	</rule>

	<!-- Rechten van plugins uit de vaste stack. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="gravityforms_view_entries"/>
				<element value="gform_full_access"/>
			</property>
		</properties>
	</rule>

	<!-- Alles in de namespace HashtagMedia\Toolkit; globale namen met hm_toolkit_.
	     Alleen de thema-helpers (hm_image() e.d.) gebruiken het korte hm_, in
	     één bestand met een gedocumenteerde uitzondering. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="HashtagMedia\Toolkit"/>
				<element value="hm_toolkit"/>
			</property>
		</properties>
	</rule>
</ruleset>
